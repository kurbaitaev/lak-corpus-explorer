modules = ["web", "python-base-3.13", "nodejs-20", "postgresql-16"]

[nix]
channel = "stable-25_05"

[agent]
expertMode = true

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Start application"

[[workflows.workflow]]
name = "Start application"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "node server.js"
waitForPort = 5000

[workflows.workflow.metadata]
outputType = "webview"

[[ports]]
localPort = 5000
externalPort = 80

[[ports]]
localPort = 5055
externalPort = 3001

[[ports]]
localPort = 5056
externalPort = 3000

[[ports]]
localPort = 5057
externalPort = 3002

[[ports]]
localPort = 5058
externalPort = 3003

[[ports]]
localPort = 5060
externalPort = 5000

[[ports]]
localPort = 5061
externalPort = 4200

[[ports]]
localPort = 5062
externalPort = 5173

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 60000

[deployment]
deploymentTarget = "autoscale"
run = ["node", "server.js"]
build = ["python3", "scripts/extract-corpus.py"]
